# Frontend: false connects to the real Java API. true is browser-only demonstration.
VITE_DEMO_MODE=false
VITE_API_URL=

# Backend: load this file into the backend terminal as described in README.md.
# Keep values shell-compatible; quote passwords containing spaces or special characters.
DB_URL='jdbc:mysql://localhost:3306/campus_cab?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=campus_cab
DB_PASSWORD='replace-with-your-local-app-password'
# Explicit local-only test mode. Code 123456; no SMS is sent.
OTP_MODE=dev
COOKIE_SECURE=false
# Production: OTP_MODE=twilio and COOKIE_SECURE=true, then supply all three secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
