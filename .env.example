# Frontend: false connects to the real Java API. true is browser-only demonstration.
VITE_DEMO_MODE=false
VITE_API_URL=

# Docker Compose local development. Choose your own database passwords.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PASSWORD=replace-with-a-local-app-password
# Explicit local-only test mode. Code 123456; no SMS is sent.
OTP_MODE=dev
COOKIE_SECURE=false
# Production: OTP_MODE=twilio and COOKIE_SECURE=true, then supply all three secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
